# Immutable sources every build of this repository resolves its sibling path
# dependencies from. Cargo.lock is committed alongside these revisions and must
# be regenerated (and re-committed) whenever either of them moves, otherwise the
# release build's `cargo build --locked` fails.
#
# Consumed by .github/workflows/{ci,publish}.yml.
ZENOH_FLAT_REF=4c982a21ae39a7b848de93caf783783f02195058
PREBINDGEN_REF=ab6338c5420ff021f462d0c470dedca0f76aac45

# The Android build tool is a release input too. `cargo install --locked` only
# makes the *selected* release build from its own lockfile — it does not pin
# which release is selected, so without an exact version a rerun of the same tag
# can cross-compile with a different cargo-ndk. Bumping this needs a validated
# Android build (4.x no longer strips output by default, which changes the .so
# sizes in the AAR).
CARGO_NDK_VERSION=4.1.2

# NDK feature level the ABIs are built against. Kept next to the cargo-ndk pin
# because the two are validated together.
ANDROID_NDK_VERSION=r26
